[Unit]
Description=Voxtype -> ChatGPT (Codex) transcribe proxy
Documentation=https://github.com/sicko7947/codex-dictate
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/codex-dictate-proxy
# Restart=always (not on-failure): this unit is PartOf=graphical-session.target,
# so a session bounce (relogin, compositor restart) sends a clean SIGTERM. With
# on-failure systemd treats that as a normal stop and does NOT revive it, leaving
# the proxy dead and dictation silently broken until the next manual start.
# "always" brings it back; it still stays down on a real logout (the whole
# target stops as one transaction).
Restart=always
RestartSec=3
# Uncomment to disable the loudness normalization or watch the audio it sends:
# Environment=CODEX_DICTATE_PROXY_NO_NORMALIZE=1
# Environment=CODEX_DICTATE_PROXY_DEBUG_DIR=/tmp

[Install]
WantedBy=graphical-session.target
