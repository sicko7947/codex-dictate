[Unit]
Description=Voxtype -> ChatGPT (Codex) transcribe proxy
Documentation=https://github.com/sicko7947/codex-dictate
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/codex-dictate-proxy
Restart=on-failure
RestartSec=3
# Uncomment to disable the loudness normalization or watch the audio it sends:
# Environment=CODEX_DICTATE_PROXY_NO_NORMALIZE=1
# Environment=CODEX_DICTATE_PROXY_DEBUG_DIR=/tmp

[Install]
WantedBy=graphical-session.target
